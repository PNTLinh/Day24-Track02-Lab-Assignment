#!/usr/bin/env bash
set -euo pipefail

# Pre-commit hook: block obvious secrets before commit.
# This avoids relying on git-secrets on Windows.

echo "Running security checks..."

staged_files=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "${staged_files}" ]; then
    echo "No staged files to scan."
    exit 0
fi

secret_patterns=(
    'CCCD[:[:space:]]+[0-9]{12}'
    'cccd[:[:space:]]+[0-9]{12}'
    'AWS_SECRET_KEY[[:space:]]*=[[:space:]]*["'"'"'\''"][^"'"'"'\''"]+["'"'"'\'']'
    'password[[:space:]]*=[[:space:]]*["'"'"'\''"][^"'"'"'\''"]+["'"'"'\'']'
    'secret_key[[:space:]]*=[[:space:]]*["'"'"'\''"][^"'"'"'\''"]+["'"'"'\'']'
)

for file in ${staged_files}; do
    if [ ! -f "${file}" ]; then
        continue
    fi

    for pattern in "${secret_patterns[@]}"; do
        if grep -Enq "${pattern}" "${file}"; then
            echo "Secret-like pattern found in ${file}: ${pattern}"
            echo "Commit blocked. Remove the secret or move it to a secure secret store."
            exit 1
        fi
    done
done

echo "All security checks passed!"
exit 0
